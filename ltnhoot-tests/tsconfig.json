{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "types": ["node", "@playwright/test"]
  },
  "include": ["tests/**/*.ts", "helpers/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "../packages"]
}
