# URL du frontend (Vite dev ou build)
BASE_URL=https://ltnhoot.ltn.re

# URL du serveur socket (même domaine en prod)
SOCKET_URL=https://ltnhoot.ltn.re

# Mot de passe manager (défini dans votre config serveur)
MANAGER_PASSWORD=admin

# Code d'invitation à utiliser pour les tests (optionnel, généré dynamiquement sinon)
# INVITE_CODE=TEST01

# Mettre à false pour activer les tests de partie réelle (mode soirée, podium, etc.)
SKIP_REAL_GAME=true

# ── Setup local (IMPORTANT : tester contre un BUILD, pas `vite dev`) ──────────
# En `vite dev`, React StrictMode remonte les composants et vide le store manager
# → le flux de création de partie échoue. Il faut servir un build de prod.
#
#   1. pnpm --filter web build
#   2. pnpm --filter web exec vite preview --port 3010 --strictPort
#   3. pnpm --filter socket dev            # socket sur :3001
#   4. dans ce .env :
#
# BASE_URL=http://localhost:3010           # build de prod servi par vite preview
# SOCKET_URL=http://localhost:3001         # socket DIRECT (l'upgrade WS y est testé,
#                                          # car vite preview ne relaie pas le WS)
# MANAGER_PASSWORD=<mot de passe de config/game.json>
# SKIP_REAL_GAME=false
#
# ── En prod / VPS ─────────────────────────────────────────────────────────────
# nginx (interne au conteneur) relaie l'upgrade /ws, donc une seule URL suffit :
# BASE_URL=https://votre-domaine      SOCKET_URL=https://votre-domaine
